rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Penalti global (info ditolak komunitas) sing isih mlaku ngunci kabeh laporan.
    function penaltiGlobalWisLiwat() {
      return !('cooldownUntilMs' in resource.data) ||
        request.time.toMillis() > resource.data.cooldownUntilMs;
    }

    // Map cooldown kudu maju: ono kunci anyar + ora oleh mbusak kunci lawas.
    function cooldownMapMaju() {
      let oldMap = resource.data.get('reportCooldowns', {});
      let newMap = request.resource.data.get('reportCooldowns', {});
      return newMap != oldMap && newMap.keys().hasAll(oldMap.keys());
    }

    // Connection testing doc
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User Profile
    // Cooldown normal wis PER SPBU+BBM (map reportCooldowns: kunci
    // `${stationId}||${bbm}` → epoch-ms) — lapor BBM bedo ora dikunci.
    // Global cooldownUntilMs mung kanggo PENALTI (info ditolak komunitas):
    // penalti sing isih mlaku ngunci kabeh laporan.
    // Aturan server:
    // - totalReports munggah +1 per tulis + wajib nggowo kunci cooldown anyar,
    //   ora oleh mbusak kunci lawas (anti-ngakali penghapusan cooldown).
    // - totalReports == 0 = reset data akun (idini).
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        request.resource.data.totalReports == resource.data.totalReports ||
        request.resource.data.totalReports == 0 ||
        (
          request.resource.data.totalReports == resource.data.totalReports + 1 &&
          penaltiGlobalWisLiwat() &&
          cooldownMapMaju()
        )
      );
      allow delete: if false;
    }

    // Vehicles
    match /vehicles/{vehicleId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Fuel Logs
    match /fuel_logs/{logId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Gas Stations & Crowdsourced status
    match /stations/{stationId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }
  }
}
