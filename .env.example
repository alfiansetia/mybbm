# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform.
# Injected automatically from user secrets in AI Studio.
# Untuk run local: buat key sendiri di Google Cloud Console > APIs & Services >
# Credentials, enable "Maps JavaScript API" SAJA, lalu batasi:
# - Application restriction: HTTP referrers -> http://localhost:* dan domain deploy kamu
# - API restriction: Maps JavaScript API saja
# Isi ke .env lalu restart vite.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_GOOGLE_PLACES_API_KEY: key TERPISAH khusus cari SPBU (Places API New).
# Buat key baru di Credentials, enable "Places API (New)" SAJA, lalu batasi:
# - Application restriction: HTTP referrers -> http://localhost:* dan domain deploy kamu
# - API restriction: Places API (New) saja
# Kalau dikosongkan, app otomatis fallback ke VITE_GOOGLE_MAPS_API_KEY lalu ke OSM gratis.
VITE_GOOGLE_PLACES_API_KEY=""

# VITE_GEMINI_API_KEY: untuk Scan Struk AI (Google Gemini, langsung dari HP tanpa backend).
# Ambil gratis di https://aistudio.google.com/apikey — tier gratis cukup untuk pemakaian wajar.
# WAJIB batasi key-nya di Google Cloud Console > APIs & Services > Credentials:
# - Application restriction: HTTP referrers -> http://localhost:* dan domain deploy kamu
# - API restriction: "Generative Language API" saja
# Kalau dikosongkan, tombol upload struk menampilkan pesan cara pasang key (form manual tetap jalan).
VITE_GEMINI_API_KEY=""

# VITE_GEMINI_MODEL: opsional, default gemini-3.8-flash (murah + cepat untuk baca struk).
VITE_GEMINI_MODEL="gemini-3.8-flash"

# VITE_GOOGLE_MAPS_MAP_ID: opsional, untuk AdvancedMarker.
# Bisa pakai "DEMO_MAP_ID" untuk dev, atau Map ID dari Cloud Console > Map Management.
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# VITE_FIREBASE_*: kredensial Firebase Web (bisa juga via firebase-applet-config.json
# yang di-gitignore). Env diprioritaskan oleh src/lib/firebase.ts.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""

