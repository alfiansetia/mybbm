# Duplikat jadi .env.deploy (gitignored, JANGAN commit) lalu isi sekali.
# deploy.sh membaca file ini — tidak perlu paste key ke console lagi.
# Ambil nilainya dari: AI Studio (GEMINI), Google Cloud Console (Maps/Places),
# Firebase Console → Project settings (VITE_FIREBASE_*).

PROJECT_ID=""
REGION="asia-southeast2"

# Rahasia server — disimpan ke Secret Manager (tidak tampil di build log).
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-3.8-flash"

# Publik (dibake ke bundle FE saat build).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIRESTORE_DATABASE_ID=""
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_PLACES_API_KEY=""
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"
